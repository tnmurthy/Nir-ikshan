# ---- Browser (bundled into the app; public by design) ----
# Leave both empty to run in demo mode (sample data, simulated sign-in, local-only storage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Force demo mode even when Supabase is configured. Never "true" on a public pilot.
VITE_DEMO_MODE=false

# ---- Server only (Vercel functions; never prefix with VITE_) ----
BHUVAN_API_TOKEN=
# Restrict API CORS to your site, e.g. https://nir-ikshan.vercel.app
ALLOWED_ORIGIN=
DEFAULT_APP_PORT=
